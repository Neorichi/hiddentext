{
  "manifest_version": 3,
  "name": "Hiddentext",
  "version": "1.1",
  "description": "Hide encrypted secrets in WhatsApp and Telegram Web messages.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{
    "resources": ["private_key"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://web.whatsapp.com/*"
      ],
      "js": ["crypto-js.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
