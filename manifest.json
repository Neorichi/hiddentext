{
  "name": "HiddenText",
  "version": "1.1",
  "description": "",
  "manifest_version": 2,
  "permissions": ["tabs","activeTab", "declarativeContent", "storage"],
  "browser_action": {
    "name": "HiddenText",
    "icons": ["icon.png"],
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "icons": { "128": "icon.png" },
  "content_scripts": [ {
    "js": [ "jquery.min.js", "background.js" ],
    "matches": [ "https://web.telegram.org/*","https://web.whatsapp.com/*"]
  }]
}
